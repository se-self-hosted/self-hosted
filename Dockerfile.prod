FROM node:22-bookworm-slim

RUN apt-get update -y && apt-get install -y --no-install-recommends openssl ca-certificates ffmpeg && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY package*.json ./
COPY prisma ./prisma
COPY prisma.config.ts ./

# prisma.config.ts reads DATABASE_URL, but `prisma generate` never connects,
# so a placeholder keeps the real credentials out of the image.
ARG DATABASE_URL="postgresql://build:build@localhost:5432/build"
ENV DATABASE_URL=$DATABASE_URL

# Dev dependencies stay installed: the deploy script runs the prisma CLI and
# the tsx seed inside this container.
RUN npm ci

COPY . .

# The build cache is only useful for rebuilding in place; dropping it keeps
# hundreds of MB out of the image.
RUN npm run build && rm -rf .next/cache

ENV NODE_ENV=production
ENV PORT=3000
ENV HOSTNAME=0.0.0.0
EXPOSE 3000

CMD ["npx", "next", "start"]
